From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Matti=20Lehtim=C3=A4ki?= <matti.lehtimaki@gmail.com>
Date: Sat, 21 Sep 2024 18:51:06 +0300
Subject: [PATCH] Revert "apps: qcam: Port to Qt 6"

This reverts commit 71aa3ceec30b152fe5a02aba968c8c72cb47149e.
---
 README.rst                |  2 +-
 src/apps/qcam/meson.build | 48 ++++++++++++++++++++++++---------------
 2 files changed, 31 insertions(+), 19 deletions(-)

diff --git a/README.rst b/README.rst
index e9a7dd82de7477748e10b651847dea89bd1b6498..c5b742e4369fd32309e3ae6466dd468338ecbc96 100644
--- a/README.rst
+++ b/README.rst
@@ -87,7 +87,7 @@ for cam: [optional]
         - libtiff-dev: Enables writing DNG
 
 for qcam: [optional]
-        libtiff-dev qt6-base-dev
+        libtiff-dev qtbase5-dev qttools5-dev-tools
 
 for tracing with lttng: [optional]
         liblttng-ust-dev python3-jinja2 lttng-tools
diff --git a/src/apps/qcam/meson.build b/src/apps/qcam/meson.build
index 9ca047b0f92703f3b1439b7738483a98a96e05a7..b395592df38195a163af1b7c768019d21faeaae8 100644
--- a/src/apps/qcam/meson.build
+++ b/src/apps/qcam/meson.build
@@ -1,13 +1,13 @@
 # SPDX-License-Identifier: CC0-1.0
 
-qt6 = import('qt6')
-qt6_dep = dependency('qt6',
+qt5 = import('qt5')
+qt5_dep = dependency('qt5',
                      method : 'pkg-config',
-                     modules : ['Core', 'Gui', 'OpenGL', 'OpenGLWidgets', 'Widgets'],
+                     modules : ['Core', 'Gui', 'Widgets'],
                      required : get_option('qcam'),
-                     version : '>=6.2')
+                     version : '>=5.4')
 
-if not qt6_dep.found()
+if not qt5_dep.found()
     qcam_enabled = false
     subdir_done()
 endif
@@ -20,38 +20,50 @@ qcam_sources = files([
     'main.cpp',
     'main_window.cpp',
     'message_handler.cpp',
-    'viewfinder_gl.cpp',
     'viewfinder_qt.cpp',
 ])
 
 qcam_moc_headers = files([
     'cam_select_dialog.h',
     'main_window.h',
-    'viewfinder_gl.h',
     'viewfinder_qt.h',
 ])
 
 qcam_resources = files([
     'assets/feathericons/feathericons.qrc',
-    'assets/shader/shaders.qrc',
 ])
 
-qt6_cpp_args = [
+qt5_cpp_args = [
     apps_cpp_args,
     '-DQT_NO_KEYWORDS',
     '-Wno-extra-semi',
 ]
 
-# gcc 12 and 13 output a false positive variable shadowing warning with Qt
-# 6.9.0 and newer. Silence it.
-if qt6_dep.version().version_compare('>=6.9.0') and \
-   cxx.version().version_compare('>=12') and cxx.version().version_compare('<14')
-    qt6_cpp_args += ['-Wno-shadow']
+if cxx.has_header_symbol('QOpenGLWidget', 'QOpenGLWidget',
+                         dependencies : qt5_dep, args : '-fPIC')
+    qcam_sources += files([
+        'viewfinder_gl.cpp',
+    ])
+    qcam_moc_headers += files([
+        'viewfinder_gl.h',
+    ])
+    qcam_resources += files([
+        'assets/shader/shaders.qrc'
+    ])
 endif
 
-resources = qt6.preprocess(moc_headers : qcam_moc_headers,
+# gcc 9 introduced a deprecated-copy warning that is triggered by Qt until
+# Qt 5.13. clang 10 introduced the same warning, but detects more issues
+# that are not fixed in Qt yet. Disable the warning manually in both cases.
+if ((cc.get_id() == 'gcc' and cc.version().version_compare('>=9.0') and
+     qt5_dep.version().version_compare('<5.13')) or
+    (cc.get_id() == 'clang' and cc.version().version_compare('>=10.0')))
+    qt5_cpp_args += ['-Wno-deprecated-copy']
+endif
+
+resources = qt5.preprocess(moc_headers : qcam_moc_headers,
                            qresources : qcam_resources,
-                           dependencies : qt6_dep)
+                           dependencies : qt5_dep)
 
 qcam  = executable('qcam', qcam_sources, resources,
                    install : true,
@@ -61,6 +73,6 @@ qcam  = executable('qcam', qcam_sources, resources,
                        libatomic,
                        libcamera_public,
                        libtiff,
-                       qt6_dep,
+                       qt5_dep,
                    ],
-                   cpp_args : qt6_cpp_args)
+                   cpp_args : qt5_cpp_args)
